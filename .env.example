# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL=theakanimoh@gmail.com

# Digits only, country code included. Example: 2348012345678
# Leave blank to hide the WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional calendar link (Calendly or similar). Leave blank to hide it.
NEXT_PUBLIC_BOOKING_URL=

# Google Sheet shared as "Anyone with the link can view".
# Tabs must be named Videos and Gallery unless you override the names below.
# Column templates live in content/templates/.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_VIDEOS=Videos
GOOGLE_SHEET_GALLERY=Gallery

# Optional. A Google Apps Script web app (or any JSON endpoint) that receives enquiries.
# When empty, the form opens the visitor's email app instead.
ENQUIRY_WEBHOOK_URL=

# Substack. Defaults point at Conversations with Akan Imoh.
NEXT_PUBLIC_SUBSTACK_URL=https://theakanimoh.substack.com
SUBSTACK_FEED_URL=https://theakanimoh.substack.com/feed

NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@theakanimoh
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/akan-imoh
